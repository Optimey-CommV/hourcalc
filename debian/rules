#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Optimey CommV
# SPDX-License-Identifier: GPL-3.0-or-later

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# The package carries the plain front ends. HOURCALC_DEB_TESTS=1 builds the test programs and
# test hooks as well and runs the tests during the build, headless (GTK under Xvfb, Qt
# offscreen; needs xvfb and xauth). The launcher test of linux/data always runs.
ifeq ($(HOURCALC_DEB_TESTS),1)
TESTS_OPTION = -Dtests=true
else
TESTS_OPTION = -Dtests=false
endif

%:
	dh $@ --buildsystem=meson

# debhelper's meson build system puts libexecdir under lib/<multiarch>; the package (and
# docs/LINUX.md) uses /usr/libexec/hourcalc.
override_dh_auto_configure:
	dh_auto_configure -- --libexecdir=libexec $(TESTS_OPTION)

ifeq ($(HOURCALC_DEB_TESTS),1)
override_dh_auto_test:
	env -u WAYLAND_DISPLAY GDK_BACKEND=x11 QT_QPA_PLATFORM=offscreen xvfb-run -a dh_auto_test
endif
